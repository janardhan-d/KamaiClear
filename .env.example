# Optional infrastructure boundary for the next MVP slice.
# Do not commit real values. Only NEXT_PUBLIC_* values may be exposed to the browser.

# Supabase browser client (future hosted persistence + auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only database connection (future reporting/admin jobs)
DATABASE_URL=

# Future auth provider selection: supabase | clerk | better-auth
AUTH_PROVIDER=supabase

# Optional server-side live assistant model. Keep this key off the client.
# The route accepts an OpenAI-compatible /chat/completions endpoint.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Future operational integrations
RESEND_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
